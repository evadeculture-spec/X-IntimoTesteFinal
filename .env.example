# Copiar para .env.local (desenvolvimento) ou definir no painel do alojamento (produção).
# NUNCA colocar segredos no código nem em variáveis NEXT_PUBLIC_*.

# Domínio final, sem barra no fim (URLs canónicos, sitemap, retorno da Stripe)
NEXT_PUBLIC_SITE_URL=https://www.exemplo.pt

# Fonte do catálogo: "store" (data/store-catalog.json) ou "demo" (dados ilustrativos).
# Se omitido: "store" quando o catálogo real tiver produtos, senão "demo".
COMMERCE_CATALOG=

# WhatsApp da loja, formato internacional só com dígitos (ex.: 3519XXXXXXXX)
WHATSAPP_NUMBER=

# Stripe (opcional — ativa o pagamento online). Usar chaves de teste (sk_test_…) primeiro.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
